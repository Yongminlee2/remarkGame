    <!-- 몸통: 둥근 네모 (아바타의 squircle 과 같은 인상) -->
    <path
        android:fillColor="#FFC533"
        android:pathData="M28,30 h52 a12,12 0 0 1 12,12 v30 a12,12 0 0 1 -12,12 h-52 a12,12 0 0 1 -12,-12 v-30 a12,12 0 0 1 12,-12 z" />

    <!-- 말풍선 꼬리: 끝말잇기(말) 게임임을 알리는 단서 -->
    <path
        android:fillColor="#FFC533"
        android:pathData="M38,82 l-4,14 16,-14 z" />

    <!-- 왼쪽 눈 -->
    <path
        android:fillColor="#2B2F45"
        android:pathData="M44,52 m-6,0 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0" />
    <!-- 오른쪽 눈 -->
    <path
        android:fillColor="#2B2F45"
        android:pathData="M70,52 m-6,0 a6,6 0 1 0 12,0 a6,6 0 1 0 -12,0" />

    <!-- 눈 하이라이트 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,50 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M72,50 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />

    <!-- 웃는 입 -->
    <path
        android:strokeColor="#2B2F45"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M46,68 q11,9 22,0" />

    <!-- 볼터치 -->
    <path
        android:fillColor="#33FF6161"
        android:pathData="M36,62 m-4,0 a4,3 0 1 0 8,0 a4,3 0 1 0 -8,0" />
